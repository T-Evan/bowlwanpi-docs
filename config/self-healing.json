{
  "version": "1.1",
  "name": "BowlWanpi Self-Healing System",
  "description": "自动检测修复系统问题",
  
  "checks": {
    "proxy": {
      "enabled": true,
      "auto_fix": true,
      "priority": "high",
      "port": 7890,
      "process": "mihomo"
    },
    "disk": {
      "enabled": true,
      "auto_fix": true,
      "priority": "medium",
      "threshold_warning": 80,
      "threshold_critical": 90
    },
    "memory": {
      "enabled": true,
      "auto_fix": false,
      "priority": "medium",
      "threshold_warning": 80,
      "threshold_critical": 90
    },
    "cron_delivery": {
      "enabled": true,
      "auto_fix": false,
      "priority": "high",
      "forbidden_channels": ["whatsapp"],
      "conflicts": [
        {"session": "isolated", "payload": "systemEvent"},
        {"session": "main", "payload": "agentTurn"}
      ]
    },
    "openclaw_status": {
      "enabled": true,
      "auto_fix": false,
      "priority": "low"
    }
  },
  
  "auto_fix_actions": {
    "proxy_restart": {
      "command": "pkill -f mihomo; sleep 2; /usr/local/bin/mihomo -f /etc/mihomo/config.yaml &",
      "timeout": 10
    },
    "clean_logs": {
      "keep_days": 7,
      "max_lines": 5000
    }
  },
  
  "notification": {
    "on_success": false,
    "on_auto_fix": true,
    "on_manual_required": true,
    "channels": ["feishu"]
  },
  
  "schedule": {
    "frequency": "hourly",
    "quick_mode": {
      "frequency": "every_30_min",
      "skip_checks": ["openclaw_status", "cron_delivery"]
    }
  }
}
