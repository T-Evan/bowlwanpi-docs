<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🥣 BowlWanpi - 一碗的AI助手 v2.0</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="pixel-agents/pixel-agent.js" defer></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        
        :root {
            --primary: #0f766e;
            --primary-dark: #115e59;
            --secondary: #ea580c;
            --accent: #0ea5a4;
            --bg: #06131a;
            --bg-elevated: #0c1f29;
            --bg-card: #102936;
            --text: #f0f9ff;
            --text-muted: #9fb6c4;
            --border: #1f3b4a;
            --success: #22c55e;
            --warning: #f59e0b;
            --danger: #ef4444;
            --shadow-soft: 0 18px 38px rgba(3, 10, 14, 0.35);
            --shadow-strong: 0 22px 56px rgba(2, 8, 12, 0.55);
            --radius-lg: 18px;
        }
        
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg);
            background-image:
                radial-gradient(circle at 12% 6%, rgba(14, 165, 164, 0.26) 0%, transparent 36%),
                radial-gradient(circle at 90% 10%, rgba(249, 115, 22, 0.2) 0%, transparent 42%),
                radial-gradient(circle at 60% 85%, rgba(20, 184, 166, 0.16) 0%, transparent 45%),
                linear-gradient(170deg, #06131a 0%, #091d27 48%, #0b2530 100%);
            color: var(--text);
            line-height: 1.6;
        }
        
        .header {
            position: relative;
            overflow: hidden;
            isolation: isolate;
            background: linear-gradient(120deg, #0f766e 0%, #0f5d63 45%, #9a3412 100%);
            padding: clamp(2.5rem, 6vw, 4.2rem) clamp(1rem, 4vw, 2.25rem);
            text-align: center;
            color: #fff;
            box-shadow: var(--shadow-strong);
        }
        
        /* Header 高光效果 */
        .header::before {
            content: "";
            position: absolute;
            inset: -40%;
            background:
                radial-gradient(circle at 18% 20%, rgba(255,255,255,.35) 0%, rgba(255,255,255,0) 55%),
                radial-gradient(circle at 82% 10%, rgba(6,182,212,.20) 0%, rgba(6,182,212,0) 55%),
                radial-gradient(circle at 70% 90%, rgba(245,158,11,.12) 0%, rgba(245,158,11,0) 60%);
            z-index: -1;
        }
        
        .header::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(0,0,0,.18) 0%, rgba(0,0,0,.45) 100%);
            z-index: -1;
            opacity: .35;
        }
        
        .header h1 { 
            font-size: clamp(1.9rem, 4.8vw, 3.2rem);
            font-weight: 800;
            letter-spacing: -0.02em;
            margin-bottom: 0.5rem;
            text-shadow: 0 18px 50px rgba(0,0,0,.35);
        }
        
        .header .subtitle { 
            font-size: clamp(.95rem, 2vw, 1.15rem);
            opacity: 0.95;
            max-width: 52ch;
            margin: 0 auto;
            color: rgba(255,255,255,.88);
        }
        
        /* 导航栏 - 毛玻璃效果 */
        .nav {
            background: rgba(30, 41, 59, 0.72);
            border-bottom: 1px solid rgba(148, 163, 184, 0.18);
            padding: 1rem 2rem;
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(14px);
            box-shadow: 0 10px 30px rgba(0,0,0,.22);
        }
        
        /* 亮色主题适配 */
        body.light-theme .nav {
            background: rgba(255, 255, 255, 0.78);
            border-bottom-color: rgba(15, 23, 42, 0.12);
        }
        
        body.light-theme .nav-links a.nav-diary {
            background: rgba(14, 165, 164, 0.12);
        }
        
        .nav-links {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            gap: 2rem;
            flex-wrap: wrap;
        }
        
        .nav-links a { color: var(--text-muted); text-decoration: none; font-weight: 500; }
        .nav-links a:hover { color: var(--primary); }
        
        /* 碗皮日记导航按钮 */
        .nav-links a.nav-diary {
            color: var(--text);
            background: rgba(14, 165, 164, 0.18);
            border: 1px solid rgba(14, 165, 164, 0.4);
            padding: 0.35rem 0.75rem;
            border-radius: 999px;
            transition: all 0.2s ease;
        }
        
        .nav-links a.nav-diary:hover {
            color: var(--text);
            background: rgba(14, 165, 164, 0.28);
            transform: translateY(-1px);
        }
        
        .container { max-width: 1400px; margin: 0 auto; padding: clamp(1.2rem, 2.5vw, 2.3rem); }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin: 2rem 0;
        }
        
        .stat-card {
            background: linear-gradient(160deg, rgba(255, 255, 255, 0.05), rgba(14, 116, 110, 0.04) 55%, rgba(255, 255, 255, 0.02));
            border: 1px solid color-mix(in srgb, var(--border) 68%, white 8%);
            border-radius: 16px;
            padding: 1.35rem;
            text-align: center;
            box-shadow: var(--shadow-soft);
            backdrop-filter: blur(4px);
            transition: transform 0.24s ease, border-color 0.24s ease, box-shadow 0.24s ease;
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(140deg, rgba(14, 165, 164, 0.16), transparent 58%);
            opacity: 0;
            transition: opacity 0.24s ease;
            pointer-events: none;
        }

        .stat-card:hover {
            transform: translateY(-4px);
            border-color: rgba(14, 165, 164, 0.55);
            box-shadow: 0 20px 45px rgba(2, 10, 15, 0.48);
        }

        .stat-card:hover::before {
            opacity: 1;
        }

        #overview .stat-card:nth-child(1) { border-top: 3px solid rgba(34, 197, 94, 0.85); }
        #overview .stat-card:nth-child(2) { border-top: 3px solid rgba(14, 165, 164, 0.88); }
        #overview .stat-card:nth-child(3) { border-top: 3px solid rgba(249, 115, 22, 0.85); }
        #overview .stat-card:nth-child(4) { border-top: 3px solid rgba(59, 130, 246, 0.85); }
        
        .stat-number {
            font-size: clamp(2.2rem, 4vw, 3.2rem);
            font-weight: 800;
            line-height: 1;
            letter-spacing: -0.02em;
            background: linear-gradient(120deg, #34d399 0%, #2dd4bf 45%, #fb923c 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 8px 18px rgba(15, 118, 110, 0.32));
        }
        
        .stat-label {
            color: var(--text-muted);
            margin-top: 0.65rem;
            font-size: 0.9rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        
        .section {
            background: linear-gradient(165deg, rgba(16, 41, 54, 0.94), rgba(11, 34, 45, 0.9));
            border: 1px solid color-mix(in srgb, var(--border) 74%, white 6%);
            border-radius: var(--radius-lg);
            padding: clamp(1.3rem, 2.4vw, 2rem);
            margin: 1.7rem 0;
            scroll-margin-top: 88px;
            box-shadow: var(--shadow-soft);
        }
        
        .section-title {
            font-size: 1.8rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .section-title::before {
            content: '';
            width: 4px;
            height: 24px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border-radius: 2px;
        }
        
        .grid-3 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.5rem;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 1.5rem;
        }

        .chart-container {
            background: rgba(255,255,255,0.02);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.5rem;
            margin: 1rem 0;
            position: relative;
            height: 300px;
        }

        .chart-title {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: var(--text);
        }

        /* Log styles */
        .log-container {
            background: linear-gradient(165deg, #08141b, #0c2029 62%, #0b1d27);
            border: 1px solid color-mix(in srgb, var(--border) 72%, white 6%);
            border-radius: 16px;
            padding: 0.9rem 1rem;
            font-family: 'Consolas', 'Monaco', monospace;
            font-size: 0.85rem;
            max-height: 420px;
            overflow-y: auto;
        }

        .log-entry {
            position: relative;
            display: grid;
            grid-template-columns: 82px 92px 1fr;
            gap: 0.7rem;
            align-items: center;
            padding: 0.65rem 0.65rem 0.65rem 1.2rem;
            margin-bottom: 0.3rem;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.04);
        }

        .log-entry::before {
            content: '';
            position: absolute;
            left: 0.45rem;
            top: 0;
            bottom: 0;
            width: 2px;
            border-radius: 999px;
            background: rgba(148, 163, 184, 0.34);
        }

        .log-entry::after {
            content: '';
            position: absolute;
            left: 0.1rem;
            top: 50%;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: rgba(148, 163, 184, 0.9);
            transform: translateY(-50%);
            box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.52);
        }

        .log-entry[data-status='DONE']::after,
        .log-entry[data-status='SUCCESS']::after {
            background: var(--success);
        }

        .log-entry[data-status='RUNNING']::after {
            background: var(--warning);
        }

        .log-entry[data-status='ERROR']::after {
            background: var(--danger);
        }

        .log-time {
            color: #90a6b3;
            flex-shrink: 0;
            font-size: 0.78rem;
        }

        .log-level-info,
        .log-level-success,
        .log-level-warning,
        .log-level-error {
            display: inline-flex;
            justify-content: center;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 0.2rem 0.5rem;
            border-radius: 999px;
            letter-spacing: 0.04em;
        }

        .log-level-info { color: #7dd3fc; background: rgba(2, 132, 199, 0.18); }
        .log-level-success { color: #86efac; background: rgba(21, 128, 61, 0.2); }
        .log-level-warning { color: #fcd34d; background: rgba(161, 98, 7, 0.22); }
        .log-level-error { color: #fca5a5; background: rgba(153, 27, 27, 0.24); }

        .log-message {
            color: #dce7ef;
            line-height: 1.5;
        }

        /* Interactive demo styles */
        .demo-container {
            background: rgba(255,255,255,0.02);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.5rem;
            margin: 1rem 0;
        }

        .demo-title {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: var(--primary);
        }

        .search-box {
            width: 100%;
            padding: 0.75rem 1rem;
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text);
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }

        .search-box:focus {
            outline: none;
            border-color: var(--primary);
        }

        .skill-tag {
            display: inline-block;
            background: rgba(99, 102, 241, 0.2);
            color: var(--primary);
            padding: 0.3rem 0.8rem;
            border-radius: 20px;
            font-size: 0.8rem;
            margin: 0.2rem;
            cursor: pointer;
            transition: all 0.3s;
        }

        .skill-tag:hover {
            background: var(--primary);
            color: white;
        }

        .skill-tag.hidden {
            display: none;
        }

        .emotion-slider {
            width: 100%;
            margin: 0.5rem 0;
        }

        .emotion-value {
            display: inline-block;
            width: 50px;
            text-align: right;
            font-weight: 600;
            color: var(--primary);
        }

        .copy-btn {
            background: rgba(255,255,255,0.1);
            border: 1px solid var(--border);
            color: var(--text);
            padding: 0.5rem 1rem;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.85rem;
            transition: all 0.3s;
        }

        .copy-btn:hover {
            background: var(--primary);
            border-color: var(--primary);
        }

        .copy-btn.copied {
            background: var(--success);
            border-color: var(--success);
        }

        .theme-toggle {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            background: var(--primary);
            color: white;
            border: none;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 1.5rem;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
            transition: all 0.3s;
            z-index: 1000;
        }

        .theme-toggle:hover {
            transform: scale(1.1);
        }

        /* Light theme */
        body.light-theme {
            --bg: #f2f7f9;
            --bg-elevated: #ecf4f6;
            --bg-card: #ffffff;
            --text: #103040;
            --text-muted: #4f6a79;
            --border: #c9dbe3;
        }

        body.light-theme {
            background-image:
                radial-gradient(circle at 8% 8%, rgba(13, 148, 136, 0.16) 0%, transparent 36%),
                radial-gradient(circle at 85% 18%, rgba(251, 146, 60, 0.12) 0%, transparent 45%),
                linear-gradient(180deg, #f4fafc 0%, #eef6f8 100%);
        }

        body.light-theme .header {
            background: linear-gradient(120deg, #0f766e 0%, #0f5d63 45%, #9a3412 100%);
        }

        body.light-theme .section {
            background: linear-gradient(175deg, #ffffff, #f4fafc);
            box-shadow: 0 16px 34px rgba(15, 50, 66, 0.1);
        }

        body.light-theme .stat-card {
            background: linear-gradient(170deg, #ffffff, #eef8fa 90%);
            box-shadow: 0 14px 28px rgba(15, 50, 66, 0.12);
        }

        body.light-theme .log-container {
            background: linear-gradient(180deg, #f7fbfd, #eef5f8);
        }

        body.light-theme .log-entry {
            background: rgba(255, 255, 255, 0.75);
            border-color: rgba(15, 23, 42, 0.1);
        }

        body.light-theme .log-message {
            color: #173240;
        }

        body.light-theme .log-time {
            color: #5a7382;
        }
        
        .card {
            background: rgba(255,255,255,0.02);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 1.5rem;
        }
        
        .card:hover { border-color: var(--primary); }
        
        .card-title {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: var(--primary);
        }
        
        ul { margin-left: 1.5rem; color: var(--text-muted); }
        li { margin: 0.3rem 0; }
        
        .footer {
            text-align: center;
            padding: 2rem;
            color: var(--text-muted);
            border-top: 1px solid var(--border);
            margin-top: 2rem;
        }
        
        .auto-update {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(6, 182, 212, 0.1));
            border: 1px solid var(--success);
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 2rem;
            text-align: center;
        }

        .skill-pill {
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 0.75rem;
            background: rgba(14, 165, 164, 0.12);
        }

        .achievement-badge {
            position: relative;
            display: grid;
            grid-template-columns: 44px 1fr auto;
            gap: 0.75rem;
            align-items: center;
            padding: 0.85rem;
            border-radius: 12px;
            border: 1px solid rgba(20, 184, 166, 0.35);
            background: linear-gradient(140deg, rgba(14, 165, 164, 0.16), rgba(15, 118, 110, 0.08) 45%, rgba(249, 115, 22, 0.1));
            box-shadow: 0 10px 22px rgba(0, 0, 0, 0.24);
            transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
            overflow: hidden;
        }

        .achievement-badge::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(130deg, rgba(255, 255, 255, 0.16), transparent 38%);
            pointer-events: none;
        }

        .achievement-badge:hover {
            transform: translateY(-2px);
            border-color: rgba(45, 212, 191, 0.6);
            box-shadow: 0 14px 26px rgba(1, 11, 14, 0.36);
        }

        .achievement-icon {
            font-size: 1.5rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 44px;
            height: 44px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.16);
        }

        .achievement-title {
            font-weight: 700;
            font-size: 0.95rem;
            color: var(--text);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .achievement-desc {
            margin-top: 0.15rem;
            font-size: 0.8rem;
            color: color-mix(in srgb, var(--text-muted) 84%, white 10%);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .achievement-points {
            font-size: 0.78rem;
            font-weight: 700;
            color: #fef3c7;
            background: rgba(146, 64, 14, 0.5);
            border: 1px solid rgba(251, 191, 36, 0.5);
            border-radius: 999px;
            padding: 0.18rem 0.55rem;
            white-space: nowrap;
        }

        .achievement-empty {
            color: var(--text-muted);
            font-size: 0.85rem;
            text-align: center;
            padding: 1rem;
            border: 1px dashed rgba(148, 163, 184, 0.35);
            border-radius: 10px;
        }

        .skill-pill small {
            color: var(--text-muted);
            display: block;
            margin-top: 0.35rem;
            line-height: 1.35;
        }

        /* 概览卡片样式 */
        .overview-card {
            background: linear-gradient(135deg, rgba(99,102,241,0.1), rgba(99,102,241,0.02));
            border: 1px solid rgba(99,102,241,0.2);
            border-radius: 12px;
            padding: 1rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .overview-card:hover {
            transform: translateY(-2px);
            border-color: rgba(99,102,241,0.4);
            background: linear-gradient(135deg, rgba(99,102,241,0.15), rgba(99,102,241,0.05));
        }
        .overview-card .number {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary);
        }
        .overview-card .label {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: 0.25rem;
        }

        /* 展开按钮样式 */
        .expand-btn {
            background: linear-gradient(135deg, rgba(99,102,241,0.15), rgba(99,102,241,0.05));
            border: 1px solid rgba(99,102,241,0.3);
            color: var(--text);
            padding: 0.6rem 1.5rem;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.9rem;
            transition: all 0.2s;
        }
        .expand-btn:hover {
            background: linear-gradient(135deg, rgba(99,102,241,0.25), rgba(99,102,241,0.1));
            border-color: rgba(99,102,241,0.5);
        }

    /* 移动端适配优化 */
@media (max-width: 768px) {
    /* 头部优化 */
    .header {
        padding: 2rem 1rem;
    }
    .header h1 {
        font-size: 2rem;
    }
    .header .subtitle {
        font-size: 1rem;
    }
    
    /* 导航优化 */
    .nav {
        padding: 0.75rem 1rem;
    }
    .nav-links {
        gap: 1rem;
        font-size: 0.85rem;
    }
    
    /* 容器优化 */
    .container {
        padding: 1rem;
    }
    
    /* 统计卡片优化 */
    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }
    .stat-card {
        padding: 1rem;
    }
    .stat-number {
        font-size: 2rem;
    }
    
    /* 区块优化 */
    .section {
        padding: 1.25rem;
        margin: 1rem 0;
    }
    .section-title {
        font-size: 1.4rem;
    }
    
    /* 网格优化 */
    .grid-2, .grid-3 {
        grid-template-columns: 1fr;
        gap: 1rem;
    }
    
    /* 图表容器优化 */
    .chart-container {
        height: 250px;
        padding: 1rem;
    }
    
    /* 技能热力图优化 */
    .skill-name {
        width: 120px;
        font-size: 0.8rem;
    }
    .skill-count {
        width: 50px;
        font-size: 0.75rem;
    }
    
    /* 对话窗口优化 */
    .chat-bubble {
        max-width: 85%;
        font-size: 0.85rem;
    }
    
    /* 关于部分卡片优化 */
    #about .grid-2 > div {
        padding: 0.75rem;
    }
}

/* 超小屏幕优化 */
@media (max-width: 480px) {
    .header h1 {
        font-size: 1.5rem;
    }
    
    .nav-links {
        gap: 0.5rem;
        font-size: 0.75rem;
    }
    
    .stats-grid {
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
    }
    
    .stat-number {
        font-size: 1.75rem;
    }
    
    .section-title {
        font-size: 1.2rem;
    }

    .log-entry {
        grid-template-columns: 1fr;
        gap: 0.4rem;
        padding-left: 1rem;
    }
}

/* 触摸设备优化 */
@media (hover: none) {
    .card:hover,
    .skill-heatmap-item:hover,
    .demo-container:hover {
        transform: none;
    }
    
    /* 增大触摸目标 */
    .nav-links a {
        padding: 0.5rem;
    }
}

/* 防止横向滚动 */
body {
    overflow-x: hidden;
}

/* 图片自适应 */
img {
    max-width: 100%;
    height: auto;
}

</style>
</head>
