                <div id="todayConversations" style="background: rgba(0,0,0,0.2); border-radius: 12px; padding: 1.5rem; margin: 1rem 0; max-height: 400px; overflow-y: auto;">
                    <!-- 对话内容由JS动态加载 -->
                </div>
                <p style="text-align: center; color: var(--text-muted); font-size: 0.85rem; margin-top: 1rem;">💡 真实对话记录，展示碗皮的工作状态和性格特点</p>
