                    </ul>
                </div>
                <div class="card">
                    <div class="card-title">三记忆系统</div>
                    <ul>
                        <li>memU (云端): ✅ 正常</li>
                        <li>Hippocampus (本地): ✅ 正常</li>
                        <li>MemOS (云端): ✅ 正常</li>
                    </ul>
                </div>
                <div class="card">
                    <div class="card-title">记忆文件</div>
                    <ul>
                        <li id="mem-files-count">总文件数: -</li>
                        <li>云端同步: 每2小时</li>
                        <li>QMDR更新: 每小时</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Docker Containers -->
        <section id="docker" class="section">
            <h2 class="section-title">🐳 Docker 容器 (<span id="docker-count">-</span>个)</h2>
            <p style="margin-bottom: 1rem; color: var(--text-muted);">运行中的容器服务状态</p>
            <div id="docker-container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem;">
                <!-- Docker 容器由JS动态加载 -->
            </div>
            <div style="margin-top: 1rem; font-size: 0.85rem; color: var(--text-muted);">
                最后更新: <span id="docker-updated">-</span>
            </div>
        </section>

        <!-- Brain Dashboard 情感状态 -->
        <section id="brain-dashboard" class="section">
            <h2 class="section-title">🎭 Brain Dashboard 情感状态</h2>
            
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem;">
                <!-- 当前心情 -->
                <div style="background: linear-gradient(135deg, rgba(14, 165, 164, 0.2), rgba(249, 115, 22, 0.14)); border: 1px solid rgba(20, 184, 166, 0.34); border-radius: 12px; padding: 1.5rem; text-align: center;">
                    <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🥣</div>
                    <div style="font-size: 1.1rem; font-weight: 600; margin-bottom: 0.3rem;">当前心情</div>
                    <div id="emotion-mood" style="color: var(--text-muted);">加载中...</div>
                </div>
                
                <!-- VTA 驱动力 -->
                <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <span style="font-size: 0.9rem;">⭐ VTA 驱动力</span>
                        <span id="emotion-drive-text" style="font-weight: bold; color: var(--success);">-</span>
                    </div>
                    <div style="width: 100%; height: 8px; background: var(--bg); border-radius: 4px; overflow: hidden;">
                        <div id="emotion-drive-bar" style="width: 0%; height: 100%; background: linear-gradient(90deg, #f59e0b, #ec4899); border-radius: 4px; transition: width 0.5s;"></div>
                    </div>
                    <div id="emotion-looking-forward" style="margin-top: 0.5rem; font-size: 0.8rem; color: var(--text-muted);">加载中...</div>
                </div>
            </div>
            
            <!-- 展开后的详细维度 -->
            <div id="emotion-detail" style="display: none; margin-top: 1.5rem;">
                <h3 style="margin: 0 0 1rem; font-size: 1.1rem; color: var(--text-muted);">🎭 Amygdala 情感维度</h3>
                <div id="emotion-dimensions" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
                    <!-- 情感维度由JS动态加载 -->
                </div>

                <h3 style="margin: 1.5rem 0 1rem; font-size: 1.1rem; color: var(--text-muted);">💭 最近感受</h3>
                <div id="emotion-recent" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 8px; padding: 1rem;">
                    <ul style="margin: 0; list-style: none;">
                        <li style="padding: 0.5rem 0;">加载中...</li>
                    </ul>
                </div>
            </div>

            <!-- 展开按钮 -->
            <div id="emotion-expand-btn" style="text-align: center; margin-top: 1rem;">
                <button onclick="toggleEmotionDetail()" style="background: linear-gradient(135deg, rgba(236,72,153,0.2), rgba(236,72,153,0.1)); border: 1px solid rgba(236,72,153,0.35); color: var(--text); padding: 0.6rem 1.5rem; border-radius: 8px; cursor: pointer; font-size: 0.9rem;">
                    🎭 查看情感详情
                </button>
            </div>

            <!-- 期待 -->
            <div id="emotion-expectation" style="margin-top: 1rem; padding: 1rem; background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(6, 182, 212, 0.1)); border: 1px solid var(--success); border-radius: 8px;">
                <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.3rem;">✨ 期待的事情</div>
                <div id="emotion-looking-forward-text">加载中...</div>
            </div>
        </section>
        

        <!-- Real-time Logs Section -->
        <section id="logs" class="section">
            <h2 class="section-title">📜 实时日志</h2>
            <p style="margin-bottom: 1rem; color: var(--text-muted);">仅展示可验证执行摘要（不展示内部思维），自动更新</p>

            <div class="log-container" id="logContainer">
                <div class="log-entry">
                    <span class="log-time">[--:--:--]</span>
                    <span class="log-level-info">[LOADING]</span>
                    <span class="log-message">正在加载可验证实时日志...</span>
                </div>
            </div>

            <div style="margin-top: 1rem; display: flex; gap: 1rem; flex-wrap: wrap;">
                <button onclick="refreshLogs()" style="background: var(--primary); color: white; border: none; padding: 0.5rem 1rem; border-radius: 6px; cursor: pointer; font-size: 0.9rem;">
                    🔄 刷新日志
                </button>
                <button onclick="clearLogs()" style="background: rgba(255,255,255,0.1); color: var(--text); border: 1px solid var(--border); padding: 0.5rem 1rem; border-radius: 6px; cursor: pointer; font-size: 0.9rem;">
                    🗑️ 清空显示
                </button>
                <span style="color: var(--text-muted); font-size: 0.85rem; align-self: center;">
                    最后更新: <span id="lastLogUpdate">2026-02-19 00:04:51</span>
                </span>
            </div>
        </section>
    </div>

        <!-- Documentation Center -->
        <section id="docs" class="section">
            <h2 class="section-title">📚 文档中心</h2>
            <p style="margin-bottom: 1.5rem; color: var(--text-muted);">完整的部署、重建、开发文档</p>
            
            <div class="grid-2">
                <!-- Quick Start -->
                <div class="demo-container">
                    <div class="demo-title">🚀 快速开始</div>
                    <ul style="list-style: none; margin: 0;">
                        <li style="padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">
                            <a href="bowlwanpi-deployment-guide.md" style="color: var(--primary); text-decoration: none;">📖 部署安装手册</a>
                            <div style="font-size: 0.8rem; color: var(--text-muted);">完整的环境配置和安装步骤</div>
                        </li>
                        <li style="padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">
                            <a href="bowlwanpi-replication-guide-main.md" style="color: var(--primary); text-decoration: none;">🔄 重建指南</a>
                            <div style="font-size: 0.8rem; color: var(--text-muted);">如何在新环境重建碗皮</div>
