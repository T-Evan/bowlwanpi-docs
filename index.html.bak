                    <div class="stat-card"><div class="stat-label">XP</div><div class="stat-value" id="gs-xp">0/100</div></div>
                    <div class="stat-card"><div class="stat-label">赛季</div><div class="stat-value" id="gs-season">T1</div></div>
                    <div class="stat-card"><div class="stat-label">赛季代币</div><div class="stat-value" id="gs-token">0</div></div>
                    <div class="stat-card"><div class="stat-label">羁绊</div><div class="stat-value" id="gs-bond">0</div></div>
                    <div class="stat-card"><div class="stat-label">连胜</div><div class="stat-value" id="gs-streak">0天</div></div>
                </div>
                <div style="margin-top:1rem;color:var(--text-muted);font-size:0.9rem;">
                    🏆 成就 <span id="gs-ach">0</span> | 🎯 日/周/赛季 <span id="gs-q">0/0/0</span> | 🛒 主题 <span id="gs-theme">-</span> | 🌳 天赋点 <span id="gs-tp">0</span>
                </div>
                <div id="gs-achievements-list" style="margin-top:1rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:0.75rem;"></div>
                <div style="margin-top:0.5rem;color:var(--text-muted);font-size:0.8rem;">最后更新: <span id="gs-updated">-</span></div>
