{
  "dagId": "site-publish-v0.1",
  "runId": "run-site-publish-sample",
  "nodes": [
    {
      "id": "generate",
      "kind": "shell",
      "command": "python3 skills/website-publisher/scripts/update.py",
      "deps": [],
      "maxRetries": 1
    },
    {
      "id": "validate",
      "kind": "shell",
      "command": "python3 skills/website-publisher/scripts/update.py --dry-run",
      "deps": ["generate"],
      "maxRetries": 1
    },
    {
      "id": "publish",
      "kind": "shell",
      "command": "python3 skills/website-publisher/scripts/publish.py",
      "deps": ["validate"],
      "maxRetries": 2
    },
    {
      "id": "notify",
      "kind": "shell",
      "command": "python3 -c \"print('site publish done')\"",
      "deps": ["publish"],
      "maxRetries": 0
    }
  ]
}
