# BowlWanpi 定时任务兜底方案
# 使用 Linux 系统级 cron，即使 OpenClaw 内置调度器挂了也能执行
# 
# 安装: sudo cp /root/.openclaw/workspace/cron/bowlwanpi-backup-cron /etc/cron.d/
# 权限: sudo chmod 644 /etc/cron.d/bowlwanpi-backup-cron
# 验证: sudo cat /var/log/cron | grep bowlwanpi

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HOME=/root

# Git Worktree 并行任务配置
WORKSPACE=/root/.openclaw/workspace
TASKS_WORKTREE=${WORKSPACE}-tasks

# 统一自愈系统 v2 - 每5分钟检查一次（保留 heartbeat_v2，移除旧 heartbeat.sh）
*/5 * * * * root /root/.openclaw/workspace/scripts/heartbeat_v2.sh > /dev/null 2>&1

# 心跳简报 - 每5分钟生成精简报告（含Agent状态）
*/5 * * * * root /root/.openclaw/workspace/scripts/send-heartbeat-report.sh >> /var/log/bowlwanpi-reports.log 2>&1

# 调度 owner 守卫 - 每小时校验 Linux/OpenClaw 单一 owner，避免双跑
15 * * * * root cd /root/.openclaw/workspace && python3 scripts/cron_owner_guard.py --check --report --quiet >> /var/log/bowlwanpi-cron-owner.log 2>&1

# [已合并到统一自愈系统] OpenClaw Guardian 功能已合并到 heartbeat_v2.sh
# */5 * * * * root /root/.openclaw/workspace/scripts/openclaw_guardian.sh check >> /var/log/bowlwanpi-guardian-check.log 2>&1 || /root/.openclaw/workspace/scripts/openclaw_guardian.sh start

# Agent News 监控 - 每小时从 HN 筛选 Agent/AI 相关新闻
0 * * * * root /root/.openclaw/workspace/scripts/agent-news-monitor.py >> /var/log/bowlwanpi-agent-news.log 2>&1

