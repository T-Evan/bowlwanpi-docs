{
  "jobs": [
    {
      "name": "安全扫描",
      "schedule": "0 3 * * 0",
      "command": "/root/.openclaw/workspace/scripts/security_cron.sh",
      "description": "每周日凌晨3点执行安全扫描",
      "enabled": true
    },
    {
      "name": "统一状态报告",
      "schedule": "*/30 * * * *",
      "command": "/root/.openclaw/workspace/scripts/heartbeat_unified.sh",
      "description": "每30分钟发送统一系统状态报告（心跳+资源+服务）",
      "enabled": true
    },
    {
      "name": "深度自检与修复",
      "schedule": "0 * * * *",
      "command": "/root/.openclaw/workspace/scripts/cron_self_check.sh",
      "description": "每小时深度自检，发现问题自动修复并报告",
      "enabled": true
    },
    {
      "name": "四记忆系统自动存储",
      "schedule": "0 * * * *",
      "command": "cd /root/.openclaw/workspace && python3 scripts/batch_store_memory_v3.py",
      "description": "每小时自动存储对话到 memU + Hippocampus + MemOS + QMDR",
      "enabled": true
    }
  ]
}
